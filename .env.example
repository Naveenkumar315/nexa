# Copy to .env and adjust. Variable names are case-insensitive.

APP_NAME=Nexa
ENV=dev
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8765

# Audio
SAMPLE_RATE=16000
CHANNELS=1
FRAME_SIZE=1280
RING_BUFFER_SECONDS=10.0
WAKE_WORD_THRESHOLD=0.5

# Must be a JSON list. Use forward slashes on Windows.
ALLOWED_FILE_ROOTS=["D:/dev"]

# Optional overrides; relative paths resolve against the project root.
# DATA_DIR=data
# LOGS_DIR=logs
